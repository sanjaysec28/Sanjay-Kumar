# Musha Empire Admin Portal — Environment Variables Reference
# ==============================================================
# Configure these variables in Vercel Project Settings > Environment Variables
# These client-side variables connect the portal to the shared Firebase project (musha-ae73e).

# Firebase Web App Configuration (Client-Safe)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="musha-ae73e.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="musha-ae73e"
VITE_FIREBASE_STORAGE_BUCKET="musha-ae73e.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
